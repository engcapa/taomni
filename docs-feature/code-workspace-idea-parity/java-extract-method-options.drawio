<mxGraphModel adaptiveColors="auto" pageWidth="1400" pageHeight="850"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" vertex="1" value="ED-PARITY-007 / DEC-02 · 首包交互取舍（待用户决定）&#10;流程示意 v1 · 非产品截图 · 1400 × 850" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#c2c9d5;fontColor=#202633;fontSize=24;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=16;"><mxGeometry as="geometry" x="30" y="20" width="1340" height="84" /></mxCell><mxCell id="a" parent="1" vertex="1" value="A · 默认名称 + 完整变更预览&#10;沿用当前事务；需要接受交互差异" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#eaf0ff;strokeColor=#c2c9d5;fontColor=#202633;fontSize=23;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=16;"><mxGeometry as="geometry" x="30" y="125" width="650" height="84" /></mxCell><mxCell id="b" parent="1" vertex="1" value="B · 保持 IDEA 内联命名目标&#10;需要补语义命名与临时编辑事务设计" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e8f5ee;strokeColor=#c2c9d5;fontColor=#202633;fontSize=23;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=16;"><mxGeometry as="geometry" x="710" y="125" width="660" height="84" /></mxCell><mxCell id="a1" parent="1" vertex="1" value="选中两条语句 → Extract Method&#10;Provider 生成默认名称&#10;不提供自定义名称 / 参数编辑" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#c2c9d5;fontColor=#202633;fontSize=23;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=16;"><mxGeometry as="geometry" x="30" y="230" width="650" height="115" /></mxCell><mxCell id="b1" parent="1" vertex="1" value="选中两条语句 → Extract Method&#10;编辑器内临时显示调用 + 新方法&#10;名称选中，可改为 calculateTotal" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#c2c9d5;fontColor=#202633;fontSize=23;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=16;"><mxGeometry as="geometry" x="710" y="230" width="660" height="115" /></mxCell><mxCell id="a2" parent="1" vertex="1" value="完整变更预览&#10;调用点 ✓ 必选    方法声明 ✓ 必选&#10;源文件尚未变化；可查看 diff&#10;[取消]                         [应用]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#c2c9d5;fontColor=#202633;fontSize=23;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=16;"><mxGeometry as="geometry" x="30" y="365" width="650" height="155" /></mxCell><mxCell id="b2" parent="1" vertex="1" value="IDEA 实采状态：getTotal → calculateTotal&#10;Enter 确认 / Esc 取消临时提取&#10;更多选项：名称、参数、签名预览&#10;原生流程无独立文件 diff Preview 按钮" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#c2c9d5;fontColor=#202633;fontSize=23;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=16;"><mxGeometry as="geometry" x="710" y="365" width="660" height="155" /></mxCell><mxCell id="a3" parent="1" vertex="1" value="确认：整组应用 → 一次撤销全部恢复&#10;保留 Taomni clean-buffer 自动保存合同&#10;取消：文本、磁盘、历史均不变" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#c2c9d5;fontColor=#202633;fontSize=23;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=16;"><mxGeometry as="geometry" x="30" y="540" width="650" height="126" /></mxCell><mxCell id="b3" parent="1" vertex="1" value="必须保证：取消零持久副作用、一次撤销&#10;当前默认 edit 路径不提供自定义名称参数&#10;不能用“先应用再普通 Rename”冒充一次提取" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#c2c9d5;fontColor=#202633;fontSize=23;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=16;"><mxGeometry as="geometry" x="710" y="540" width="660" height="126" /></mxCell><mxCell id="footer" parent="1" vertex="1" value="共同验收：Java 输出 13:1；冲突 / 迟到不得覆盖；保留 Rename / recovery。&#10;A 是明确偏离 IDEA 的首包候选，未获得接受；B 保留对齐目标，需核定事务设计与 P0 范围。&#10;当前卡保持 deferred；本图不授权开发，不表示已实现或已验证。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#c2c9d5;fontColor=#202633;fontSize=23;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=16;"><mxGeometry as="geometry" x="30" y="690" width="1340" height="130" /></mxCell></root></mxGraphModel>