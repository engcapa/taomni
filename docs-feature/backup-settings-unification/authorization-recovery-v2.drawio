<mxGraphModel adaptiveColors="auto" page="1" pageWidth="950" pageHeight="1040" background="#F5F7FB"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" parent="1" vertex="1" value="" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;rounded=1;arcSize=8;fillColor=#F5F7FB;strokeColor=none;container=1;pointerEvents=0;"><mxGeometry x="0" y="0" width="950" height="1040" as="geometry" /></mxCell><mxCell id="3" parent="1" vertex="1" value="⌄ 备份与恢复" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=22;fontColor=#1E293B;fontStyle=1;spacing=0;"><mxGeometry x="32.0" y="32" width="580" height="40" as="geometry" /></mxCell><mxCell id="4" parent="1" vertex="1" value="管理备份范围、存储渠道、后台任务与恢复。" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#64748B;fontStyle=0;spacing=0;"><mxGeometry x="32.0" y="78" width="690" height="28" as="geometry" /></mxCell><mxCell id="5" parent="1" vertex="1" value="✓ 所有更改已保存" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;rounded=1;arcSize=40;fillColor=#EAF8F0;strokeColor=none;fontColor=#19734A;fontSize=12;"><mxGeometry x="772.0" y="40" width="144" height="28" as="geometry" /></mxCell><mxCell id="6" parent="1" vertex="1" value="#714：活动授权提示独立于当前选中的渠道" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#1E293B;fontStyle=1;spacing=0;"><mxGeometry x="32.0" y="112" width="870" height="30" as="geometry" /></mxCell><mxCell id="7" parent="1" vertex="1" value="" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;rounded=1;arcSize=8;fillColor=#FFF8E9;strokeColor=#EFDDB3;container=1;pointerEvents=0;"><mxGeometry x="32.0" y="154" width="884" height="188" as="geometry" /></mxCell><mxCell id="8" parent="7" vertex="1" value="正在连接「飞书 · 个人」 · 等待浏览器确认" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#1E293B;fontStyle=1;spacing=0;"><mxGeometry x="22" y="16" width="826" height="30" as="geometry" /></mxCell><mxCell id="9" parent="7" vertex="1" value="浏览器登录了错误账号？先取消本次授权，切换浏览器账号后重新连接。" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E293B;fontStyle=0;spacing=0;"><mxGeometry x="22" y="57" width="828" height="28" as="geometry" /></mxCell><mxCell id="10" parent="7" vertex="1" value="取消授权" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#D7DDE8;fontColor=#C44141;fontSize=13;"><mxGeometry x="22" y="101" width="130" height="36" as="geometry" /></mxCell><mxCell id="11" parent="7" vertex="1" value="重新打开网页" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#D7DDE8;fontColor=#344256;fontSize=13;"><mxGeometry x="166" y="101" width="154" height="36" as="geometry" /></mxCell><mxCell id="12" parent="7" vertex="1" value="定位到渠道" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#D7DDE8;fontColor=#344256;fontSize=13;"><mxGeometry x="334" y="101" width="130" height="36" as="geometry" /></mxCell><mxCell id="13" parent="7" vertex="1" value="移除本地任务…" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#A43D35;fontStyle=0;spacing=0;"><mxGeometry x="674" y="105" width="174" height="28" as="geometry" /></mxCell><mxCell id="14" parent="7" vertex="1" value="切换渠道或添加新渠道后，此提示和取消入口仍然可见。" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#8E6E2D;fontStyle=0;spacing=0;"><mxGeometry x="22" y="151" width="828" height="24" as="geometry" /></mxCell><mxCell id="15" parent="1" vertex="1" value="" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#DFE5EF;container=1;pointerEvents=0;"><mxGeometry x="32.0" y="362" width="884" height="114" as="geometry" /></mxCell><mxCell id="16" parent="15" vertex="1" value="当前正在编辑：另一个飞书渠道" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#1E293B;fontStyle=1;spacing=0;"><mxGeometry x="22" y="14" width="816" height="30" as="geometry" /></mxCell><mxCell id="17" parent="15" vertex="1" value="仍可浏览其他配置。涉及运行中连接的修改显示明确原因；取消授权入口始终可用。" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748B;fontStyle=0;spacing=0;"><mxGeometry x="22" y="53" width="814" height="42" as="geometry" /></mxCell><mxCell id="18" parent="1" vertex="1" value="点击取消后：等待后台确认停止，再允许重新连接" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#1E293B;fontStyle=1;spacing=0;"><mxGeometry x="32.0" y="500" width="870" height="30" as="geometry" /></mxCell><mxCell id="19" parent="1" vertex="1" value="" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;rounded=1;arcSize=8;fillColor=#F3F7FA;strokeColor=#D8E2EB;container=1;pointerEvents=0;"><mxGeometry x="32.0" y="548" width="884" height="174" as="geometry" /></mxCell><mxCell id="20" parent="19" vertex="1" value="本次授权已取消" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#1E293B;fontStyle=1;spacing=0;"><mxGeometry x="22" y="18" width="820" height="30" as="geometry" /></mxCell><mxCell id="21" parent="19" vertex="1" value="已停止本地请求与轮询，可重新连接。已保存的应用与其他渠道仍然保留。" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1E293B;fontStyle=0;spacing=0;"><mxGeometry x="22" y="57" width="826" height="26" as="geometry" /></mxCell><mxCell id="22" parent="19" vertex="1" value="重新连接" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;rounded=1;arcSize=14;fillColor=#4664E6;strokeColor=#4664E6;fontColor=#FFFFFF;fontSize=13;"><mxGeometry x="22" y="103" width="170" height="36" as="geometry" /></mxCell><mxCell id="23" parent="19" vertex="1" value="重新选择应用" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#D7DDE8;fontColor=#344256;fontSize=13;"><mxGeometry x="206" y="103" width="154" height="36" as="geometry" /></mxCell><mxCell id="24" parent="19" vertex="1" value="移除本地任务" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#D7DDE8;fontColor=#344256;fontSize=13;"><mxGeometry x="694" y="103" width="168" height="36" as="geometry" /></mxCell><mxCell id="25" parent="1" vertex="1" value="选择移除时：先终止活动授权，再移除本地任务记录" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#1E293B;fontStyle=1;spacing=0;"><mxGeometry x="32.0" y="746" width="870" height="30" as="geometry" /></mxCell><mxCell id="26" parent="1" vertex="1" value="" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#DFE5EF;container=1;pointerEvents=0;"><mxGeometry x="32.0" y="792" width="884" height="144" as="geometry" /></mxCell><mxCell id="27" parent="26" vertex="1" value="移除此授权任务？" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#1E293B;fontStyle=1;spacing=0;"><mxGeometry x="22" y="15" width="830" height="28" as="geometry" /></mxCell><mxCell id="28" parent="26" vertex="1" value="将停止本地等待并移除此记录。网页上已创建的飞书应用不会被删除。" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748B;fontStyle=0;spacing=0;"><mxGeometry x="22" y="51" width="834" height="34" as="geometry" /></mxCell><mxCell id="29" parent="26" vertex="1" value="保留任务" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#D7DDE8;fontColor=#344256;fontSize=13;"><mxGeometry x="562" y="97" width="132" height="36" as="geometry" /></mxCell><mxCell id="30" parent="26" vertex="1" value="停止并移除" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#D7DDE8;fontColor=#C44141;fontSize=13;"><mxGeometry x="708" y="97" width="154" height="36" as="geometry" /></mxCell><mxCell id="31" parent="1" vertex="1" value="方案 V2 · 仅 Backup 分组内的授权恢复 · 拟议修复，非问题复现截图" style="fontFamily=Microsoft YaHei;whiteSpace=wrap;html=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#8290A5;fontStyle=0;spacing=0;"><mxGeometry x="32.0" y="974" width="880" height="28" as="geometry" /></mxCell></root></mxGraphModel>