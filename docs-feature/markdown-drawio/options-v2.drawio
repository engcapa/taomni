<mxfile host="app.diagrams.net"><diagram id="markdown-drawio-v2" name="导入与导出 V2"><mxGraphModel adaptiveColors="auto" page="1" pageWidth="1220" pageHeight="760"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" parent="1" vertex="1" value="Markdown → draw.io：导出选项" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=14;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#1f2937;fontSize=20;fontStyle=1;fillColor=#eff6ff;strokeColor=#93c5fd;"><mxGeometry as="geometry" x="20" y="20" width="560" height="58" /></mxCell><mxCell id="c2" parent="1" vertex="1" value="导出内容   ● 全文档   ○ 全部图片 / Mermaid" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=14;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#1f2937;"><mxGeometry as="geometry" x="20" y="96" width="560" height="48" /></mxCell><mxCell id="c3" parent="1" vertex="1" value="页面布局   ● 文档页 + 每图独立 Sheet&#10;                 ○ 所有内容放同一 Sheet" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=14;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#1f2937;"><mxGeometry as="geometry" x="20" y="158" width="560" height="75" /></mxCell><mxCell id="c4" parent="1" vertex="1" value="文字：可编辑文本，保留标题层级、列表与代码&#10;表格：可编辑单元格，保留行列与表头&#10;图形：Mermaid 优先转节点 / 连线；不支持时 SVG 回退" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=14;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#1f2937;fillColor=#f8fafc;"><mxGeometry as="geometry" x="20" y="250" width="560" height="112" /></mxCell><mxCell id="c5" parent="1" vertex="1" value="页面预览&#10;[文档] [图 1 · 流程] [图 2 · 时序] [图片 3]" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=14;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#1f2937;fillColor=#f8fafc;"><mxGeometry as="geometry" x="20" y="382" width="560" height="82" /></mxCell><mxCell id="c6" parent="1" vertex="1" value="保存 .drawio 文件" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=14;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#1f2937;align=center;fillColor=#2563eb;fontColor=#ffffff;strokeColor=#2563eb;"><mxGeometry as="geometry" x="20" y="488" width="265" height="48" /></mxCell><mxCell id="c7" parent="1" vertex="1" value="复制在线链接" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=14;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#1f2937;align=center;fillColor=#eff6ff;strokeColor=#93c5fd;"><mxGeometry as="geometry" x="305" y="488" width="275" height="48" /></mxCell><mxCell id="c8" parent="1" vertex="1" value="独立 Mermaid 的悬浮 / 右键保存菜单&#10;SVG · 高清 PNG · draw.io 文件 · draw.io 在线链接" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=14;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#1f2937;"><mxGeometry as="geometry" x="20" y="560" width="560" height="82" /></mxCell><mxCell id="c9" parent="1" vertex="1" value="draw.io → Markdown：导入预览" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=14;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#1f2937;fontSize=20;fontStyle=1;fillColor=#eff6ff;strokeColor=#93c5fd;"><mxGeometry as="geometry" x="620" y="20" width="560" height="58" /></mxCell><mxCell id="c10" parent="1" vertex="1" value="选择 .drawio 文件 → 解析页面 → 选择要导入的页" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=14;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#1f2937;"><mxGeometry as="geometry" x="620" y="96" width="560" height="48" /></mxCell><mxCell id="c11" parent="1" vertex="1" value="页面   ☑ Sheet 1   ☑ Sheet 2   ☐ Sheet 3&#10;每页预览；全选 / 取消全选" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=14;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#1f2937;"><mxGeometry as="geometry" x="620" y="158" width="560" height="75" /></mxCell><mxCell id="c12" parent="1" vertex="1" value="导入方式 1：保留 Sheet 图形布局&#10;所选 Sheet 保留原始 XML，离线渲染为矢量预览&#10;正文和原始 draw.io 数据一并保存在 MD" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=14;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#1f2937;fillColor=#f0fdf4;strokeColor=#86efac;"><mxGeometry as="geometry" x="620" y="250" width="560" height="112" /></mxCell><mxCell id="c13" parent="1" vertex="1" value="导入方式 2：优先还原 Markdown 文字与表格&#10;识别的文字 / 表格变成正文，其余图形保留 XML&#10;导入前须明确选择方式 1 或 2" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=14;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#1f2937;fillColor=#fff7ed;strokeColor=#fdba74;"><mxGeometry as="geometry" x="620" y="382" width="560" height="106" /></mxCell><mxCell id="c14" parent="1" vertex="1" value="取消" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=14;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#1f2937;align=center;"><mxGeometry as="geometry" x="620" y="512" width="180" height="48" /></mxCell><mxCell id="c15" parent="1" vertex="1" value="插入所选页面" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=14;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#1f2937;align=center;fillColor=#2563eb;fontColor=#ffffff;strokeColor=#2563eb;"><mxGeometry as="geometry" x="820" y="512" width="360" height="48" /></mxCell><mxCell id="c16" parent="1" vertex="1" value="V2 示意图 · 非已实现界面&#10;在线链接包含所选内容；文件保存沿用上次成功目录。" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=14;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#1f2937;fontSize=12;fillColor=#f8fafc;"><mxGeometry as="geometry" x="620" y="584" width="560" height="58" /></mxCell></root></mxGraphModel></diagram></mxfile>