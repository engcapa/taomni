<mxfile host="Desktop" type="device">
  <diagram id="workflow" name="Drawing round trip">
    <mxGraphModel background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="load" parent="1" vertex="1" value="Load request" style="shape=rectangle;rounded=1;arcSize=24;fillColor=#9ac6ff;strokeColor=#47668c;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#111827;">
          <mxGeometry x="30" y="30" width="126" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="check" parent="1" vertex="1" value="Validate" style="shape=rhombus;fillColor=#ffd470;strokeColor=#47668c;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#111827;">
          <mxGeometry x="238" y="24" width="140" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="save" parent="1" vertex="1" value="Save result" style="shape=ellipse;fillColor=#7ed9a8;strokeColor=#47668c;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#111827;">
          <mxGeometry x="240" y="180" width="136" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="submit" parent="1" edge="1" source="load" target="check" value="Submit" style="edgeStyle=none;endArrow=block;endFill=1;strokeColor=#8b30ce;strokeWidth=3;fontFamily=Arial;fontSize=14;fontColor=#111827;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="accept" parent="1" edge="1" source="check" target="save" value="OK" style="edgeStyle=none;endArrow=block;endFill=1;strokeColor=#8b30ce;strokeWidth=3;fontFamily=Arial;fontSize=14;fontColor=#111827;labelBackgroundColor=#ffffff;">
          <mxGeometry x="-0.1" y="22" relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="retry" parent="1" edge="1" source="save" target="load" value="Retry" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;dashed=1;strokeColor=#8b30ce;strokeWidth=3;fontFamily=Arial;fontSize=14;fontColor=#111827;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="93" y="213"/></Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
