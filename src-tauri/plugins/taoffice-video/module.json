{
  "id": "taomni-plugin-taoffice-video",
  "slug": "taoffice-video",
  "name": "TaOffice Media",
  "description": "Play local media, prepare compatible playback for legacy video, and save trimmed or resized video copies.",
  "version": "0.3.0",
  "coreApiVersion": "1",
  "kind": "media",
  "status": "provisional",
  "platforms": [
    "windows-x86_64",
    "darwin-aarch64",
    "darwin-x86_64",
    "linux-x86_64"
  ],
  "entry": {
    "frontend": "frontend/index.js",
    "protocol": 1,
    "host": "taomni-plugin-taoffice-video"
  },
  "document": {
    "fileKinds": [
      "audio",
      "video"
    ],
    "extensions": [
      "mp4",
      "m4v",
      "webm",
      "mov",
      "mkv",
      "avi",
      "flv",
      "wmv",
      "rm",
      "rmvb",
      "3gp",
      "mp3",
      "wav",
      "flac",
      "ogg",
      "m4a",
      "aac"
    ]
  },
  "tabs": [],
  "commands": [
    "media/begin",
    "media/append",
    "media/convert",
    "media/status",
    "media/read",
    "media/close"
  ],
  "permissions": [
    "fs.readUserFile"
  ],
  "dataDir": "plugins/taoffice-video",
  "dataSchemaVersion": 1,
  "backupPaths": [],
  "legacyTables": [],
  "vaultFixedKeys": [],
  "snapshot": "file"
}
