{
  "id": "taomni-plugin-rdp-client",
  "slug": "rdp-client",
  "name": "RDP Client",
  "description": "Connect to remote desktops with RDP, including RD Gateway, clipboard, audio and drive redirection.",
  "version": "0.1.2",
  "coreApiVersion": "1",
  "kind": "remote-client",
  "status": "stable",
  "platforms": ["windows-x86_64", "darwin-aarch64", "darwin-x86_64", "linux-x86_64"],
