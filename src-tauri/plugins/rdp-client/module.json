  "tabs": [],
  "commands": [
    "rdp/start", "rdp/close", "rdp/test", "rdp/start-gateway", "rdp/test-gateway",
    "rdp/trust-certificate", "backup/prepare", "backup/snapshot", "backup/release"
  ],
  "permissions": ["fs.dataDir"],
  "dataDir": "plugins/rdp-client",
  "dataSchemaVersion": 1,
  "backupPaths": ["plugins/rdp-client/data/data.db"],
