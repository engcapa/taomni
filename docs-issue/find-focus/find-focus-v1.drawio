height="68" /></mxCell><mxCell id="text1" value="Project [tree] example&#10;The editor buffer should survive tree navigation." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;fontFamily=Microsoft YaHei UI;fontSize=17;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="241" width="560" height="110" /></mxCell><mxCell id="text2" value="Project [tree] example&#10;The editor buffer should survive tree navigation." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;fontFamily=Microsoft YaHei UI;fontSize=17;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="620" y="173" width="560" height="110" /></mxCell><mxCell id="note1" value="Find 输入持焦；首处选中，其余处高亮。&#10;Enter → 第 2 处；Shift+Enter → 第 1 处。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DBEAFE;strokeColor=#64748B;fontColor=#0F172A;fontFamily=Microsoft YaHei UI;fontSize=18;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="370" width="560" height="82" /></mxCell><mxCell id="note2" value="正文持焦，保留当前匹配的 4 字符选区。&#10;不强制回到打开前的 1:1；正文/undo 不变。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DCFCE7;strokeColor=#64748B;fontColor=#0F172A;fontFamily=Microsoft YaHei UI;fontSize=18;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="620" y="370" width="560" height="82" /></mxCell><mxCell id="retained" value="保留：Replace 通过展开入口 / 原动作可达；过滤与 Preserve Case 不削减。&#10;Find/Replace 的 query、selection、modifier 与待执行回调按原 view 归属。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FEF3C7;strokeColor=#64748B;fontColor=#0F172A;fontFamily=Microsoft YaHei UI;fontSize=18;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="475" width="1160" height="83" /></mxCell><mxCell id="boundary" value="标注框不是产品控件。尺寸目标见参照的原始像素表；本图用于审阅结构/焦点。&#10;本稿不设计全局主题、Project 树、IDEA 插件或新的数据模型。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontFamily=Microsoft YaHei UI;fontSize=18;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="581" width="1160" height="78" /></mxCell></root></mxGraphModel>