<mxGraphModel adaptiveColors="auto" page="1" pageWidth="1080" pageHeight="690" background="#111214"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="拟议修复 v1 · 删除重构后的类文件（非实测截图）" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#111214;strokeColor=#434751;fontColor=#e7e9ee;fontSize=21;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="15" width="1040" height="50" /></mxCell><mxCell id="before" value="当前：打开工程 → 恢复提示 → 文件缺失 / 冲突 → 只能保留记录 → 重开再次提示" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#34282a;strokeColor=#434751;fontColor=#e7e9ee;fontSize=17;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="80" width="1040" height="65" /></mxCell><mxCell id="panel1" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#202226;strokeColor=#434751;fontColor=#e7e9ee;fontSize=16;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="165" width="510" height="425" /></mxCell><mxCell id="head1" value="A · 查看未完成重构" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#202226;strokeColor=#434751;fontColor=#e7e9ee;fontSize=20;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="180" width="480" height="45" /></mxCell><mxCell id="content1" value="工程：ique&#10;&#10;原路径：src/main/java/com/ipinyou/&#10;alphadesk/ique/MyTest.java    [不存在]&#10;&#10;新路径：src/main/java/com/ipinyou/&#10;alphadesk/ique/MyTesting.java [不存在]&#10;&#10;无法确认文件为何缺失，本次恢复不会新建文件。&#10;检查全部受影响文件后，可保留或放弃恢复。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#202226;strokeColor=#434751;fontColor=#e7e9ee;fontSize=15;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="230" width="480" height="230" /></mxCell><mxCell id="keep" value="保留待恢复" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#35383f;strokeColor=#434751;fontColor=#e7e9ee;fontSize=15;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="480" width="140" height="45" /></mxCell><mxCell id="dismiss" value="放弃本次恢复…" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#416bab;strokeColor=#434751;fontColor=#e7e9ee;fontSize=15;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="210" y="480" width="190" height="45" /></mxCell><mxCell id="note1" value="关闭 / Esc = 保留；真实可恢复时沿用恢复确认。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#202226;strokeColor=#434751;fontColor=#aab1bd;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="535" width="480" height="40" /></mxCell><mxCell id="panel2" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#202226;strokeColor=#434751;fontColor=#e7e9ee;fontSize=16;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="165" width="510" height="425" /></mxCell><mxCell id="head2" value="B · 放弃本次恢复？" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#202226;strokeColor=#434751;fontColor=#e7e9ee;fontSize=20;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="565" y="180" width="480" height="45" /></mxCell><mxCell id="content2" value="将结束这条重构恢复提醒。&#10;&#10;当前文件、删除状态和其他引用文件保持原样。&#10;不会恢复文件，也不会判定重构成功。&#10;&#10;以后重新打开工程，不再提示这一条记录。&#10;其他待恢复记录仍保留。&#10;&#10;如仍需找回文件，请取消并先检查恢复资料。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#202226;strokeColor=#434751;fontColor=#e7e9ee;fontSize=16;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="565" y="235" width="480" height="230" /></mxCell><mxCell id="cancel" value="取消" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#35383f;strokeColor=#434751;fontColor=#e7e9ee;fontSize=15;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="575" y="480" width="130" height="45" /></mxCell><mxCell id="confirm" value="放弃恢复" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#416bab;strokeColor=#434751;fontColor=#e7e9ee;fontSize=15;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="730" y="480" width="165" height="45" /></mxCell><mxCell id="note2" value="只有记录保存成功，才结束提醒；失败可重试。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#202226;strokeColor=#434751;fontColor=#aab1bd;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="565" y="535" width="480" height="40" /></mxCell><mxCell id="footer" value="推荐：逐条确认放弃，保留审计快照。备选：发现两端缺失就自动关闭（可能掩盖中断或外部删除）。&#10;示意图画布 1080 × 690；产品弹窗需适配截图中的 736 × 375 窗口，内容滚动、按钮始终可见。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#111214;strokeColor=#434751;fontColor=#e7e9ee;fontSize=15;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="605" width="1040" height="70" /></mxCell></root></mxGraphModel>